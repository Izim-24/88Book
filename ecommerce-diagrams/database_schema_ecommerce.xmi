<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
    xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
    xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

    <uml:Model xmi:id="model_db" name="E-commerce Database Schema">
        <packagedElement xmi:type="uml:Package" xmi:id="pkg_db" name="Database">

            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_int" name="INT"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_varchar" name="VARCHAR"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_text" name="TEXT"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_decimal" name="DECIMAL"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_datetime" name="DATETIME"/>

            <packagedElement xmi:type="uml:Class" xmi:id="t_customers" name="CUSTOMERS" stereotype="table">
                <ownedAttribute xmi:id="t_customers_1" name="customer_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_customers_2" name="full_name" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_customers_3" name="email" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_customers_4" name="password" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_customers_5" name="phone" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_customers_6" name="address" type="pt_text"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_categories" name="CATEGORIES">
                <ownedAttribute xmi:id="t_categories_1" name="category_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_categories_2" name="name" type="pt_varchar"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_products" name="PRODUCTS">
                <ownedAttribute xmi:id="t_products_1" name="product_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_products_2" name="category_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_products_3" name="name" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_products_4" name="description" type="pt_text"/>
                <ownedAttribute xmi:id="t_products_5" name="price" type="pt_decimal"/>
                <ownedAttribute xmi:id="t_products_6" name="image_url" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_products_7" name="stock" type="pt_int"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_carts" name="CARTS">
                <ownedAttribute xmi:id="t_carts_1" name="cart_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_carts_2" name="customer_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_carts_3" name="created_date" type="pt_datetime"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_cart_items" name="CART_ITEMS">
                <ownedAttribute xmi:id="t_cart_items_1" name="cart_item_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_cart_items_2" name="cart_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_cart_items_3" name="product_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_cart_items_4" name="quantity" type="pt_int"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_orders" name="ORDERS">
                <ownedAttribute xmi:id="t_orders_1" name="order_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_orders_2" name="customer_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_orders_3" name="order_date" type="pt_datetime"/>
                <ownedAttribute xmi:id="t_orders_4" name="total_amount" type="pt_decimal"/>
                <ownedAttribute xmi:id="t_orders_5" name="status" type="pt_varchar"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_order_items" name="ORDER_ITEMS">
                <ownedAttribute xmi:id="t_order_items_1" name="order_item_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_order_items_2" name="order_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_order_items_3" name="product_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_order_items_4" name="quantity" type="pt_int"/>
                <ownedAttribute xmi:id="t_order_items_5" name="unit_price" type="pt_decimal"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_search_histories" name="SEARCH_HISTORIES">
                <ownedAttribute xmi:id="t_sh_1" name="search_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_sh_2" name="customer_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_sh_3" name="search_type" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_sh_4" name="query_text" type="pt_text"/>
                <ownedAttribute xmi:id="t_sh_5" name="image_url" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_sh_6" name="created_at" type="pt_datetime"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_voice_queries" name="VOICE_SEARCH_QUERIES">
                <ownedAttribute xmi:id="t_vq_1" name="voice_query_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_vq_2" name="search_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_vq_3" name="audio_path" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_vq_4" name="recognized_text" type="pt_text"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="t_image_queries" name="IMAGE_SEARCH_QUERIES">
                <ownedAttribute xmi:id="t_iq_1" name="image_query_id (PK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_iq_2" name="search_id (FK)" type="pt_int"/>
                <ownedAttribute xmi:id="t_iq_3" name="image_path" type="pt_varchar"/>
                <ownedAttribute xmi:id="t_iq_4" name="extracted_features" type="pt_text"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_products_category" name="FK_PRODUCTS_CATEGORY">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_products_category_e1" name="category" type="t_categories" association="fk_products_category"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_products_category_e2" name="products" type="t_products" association="fk_products_category"/>
                <memberEnd xmi:idref="fk_products_category_e1"/>
                <memberEnd xmi:idref="fk_products_category_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_carts_customer" name="FK_CARTS_CUSTOMER">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_carts_customer_e1" name="customer" type="t_customers" association="fk_carts_customer"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_carts_customer_e2" name="carts" type="t_carts" association="fk_carts_customer"/>
                <memberEnd xmi:idref="fk_carts_customer_e1"/>
                <memberEnd xmi:idref="fk_carts_customer_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_cartitems_cart" name="FK_CARTITEMS_CART">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_cartitems_cart_e1" name="cart" type="t_carts" association="fk_cartitems_cart"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_cartitems_cart_e2" name="cartItems" type="t_cart_items" association="fk_cartitems_cart"/>
                <memberEnd xmi:idref="fk_cartitems_cart_e1"/>
                <memberEnd xmi:idref="fk_cartitems_cart_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_cartitems_product" name="FK_CARTITEMS_PRODUCT">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_cartitems_product_e1" name="product" type="t_products" association="fk_cartitems_product"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_cartitems_product_e2" name="cartItems" type="t_cart_items" association="fk_cartitems_product"/>
                <memberEnd xmi:idref="fk_cartitems_product_e1"/>
                <memberEnd xmi:idref="fk_cartitems_product_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_orders_customer" name="FK_ORDERS_CUSTOMER">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_orders_customer_e1" name="customer" type="t_customers" association="fk_orders_customer"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_orders_customer_e2" name="orders" type="t_orders" association="fk_orders_customer"/>
                <memberEnd xmi:idref="fk_orders_customer_e1"/>
                <memberEnd xmi:idref="fk_orders_customer_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_orderitems_order" name="FK_ORDERITEMS_ORDER">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_orderitems_order_e1" name="order" type="t_orders" association="fk_orderitems_order"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_orderitems_order_e2" name="orderItems" type="t_order_items" association="fk_orderitems_order"/>
                <memberEnd xmi:idref="fk_orderitems_order_e1"/>
                <memberEnd xmi:idref="fk_orderitems_order_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_orderitems_product" name="FK_ORDERITEMS_PRODUCT">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_orderitems_product_e1" name="product" type="t_products" association="fk_orderitems_product"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_orderitems_product_e2" name="orderItems" type="t_order_items" association="fk_orderitems_product"/>
                <memberEnd xmi:idref="fk_orderitems_product_e1"/>
                <memberEnd xmi:idref="fk_orderitems_product_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_search_customer" name="FK_SEARCH_CUSTOMER">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_search_customer_e1" name="customer" type="t_customers" association="fk_search_customer"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_search_customer_e2" name="searchHistories" type="t_search_histories" association="fk_search_customer"/>
                <memberEnd xmi:idref="fk_search_customer_e1"/>
                <memberEnd xmi:idref="fk_search_customer_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_voice_search" name="FK_VOICE_SEARCH">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_voice_search_e1" name="searchHistory" type="t_search_histories" association="fk_voice_search"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_voice_search_e2" name="voiceQueries" type="t_voice_queries" association="fk_voice_search"/>
                <memberEnd xmi:idref="fk_voice_search_e1"/>
                <memberEnd xmi:idref="fk_voice_search_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="fk_image_search" name="FK_IMAGE_SEARCH">
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_image_search_e1" name="searchHistory" type="t_search_histories" association="fk_image_search"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="fk_image_search_e2" name="imageQueries" type="t_image_queries" association="fk_image_search"/>
                <memberEnd xmi:idref="fk_image_search_e1"/>
                <memberEnd xmi:idref="fk_image_search_e2"/>
            </packagedElement>

        </packagedElement>
    </uml:Model>
</xmi:XMI>
