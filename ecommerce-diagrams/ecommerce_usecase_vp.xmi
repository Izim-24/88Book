<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
    xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
    xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

    <uml:Model xmi:id="model_1" name="E-commerce System">
        <packagedElement xmi:type="uml:Package" xmi:id="pkg_1" name="E-commerce System">

            <packagedElement xmi:type="uml:Actor" xmi:id="actor_customer" name="Customer"/>

            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_register_account" name="Register account"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_login" name="Login"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_search_product" name="Search Product">
                <ownedExtensionPoint xmi:id="ep_search_text" name="Search by Text"/>
                <ownedExtensionPoint xmi:id="ep_filter_search_results" name="Filter search results"/>
            </packagedElement>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_view_product" name="View Product"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_add_to_cart" name="Add to cart"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_place_order" name="Place Order"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_view_ordered_products" name="View ordered products"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_manage_cart" name="Manage cart"/>

            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_search_by_text" name="Search by Text"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_filter_search_results" name="Filter search results"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_search_by_voice" name="Search by Voice"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_record_voice_query" name="Record Voice Query"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_search_by_image" name="Search by Image"/>
            <packagedElement xmi:type="uml:UseCase" xmi:id="uc_upload_image" name="Upload Image"/>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_register">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_register_source" type="actor_customer" association="assoc_customer_register"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_register_target" type="uc_register_account" association="assoc_customer_register"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_login">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_login_source" type="actor_customer" association="assoc_customer_login"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_login_target" type="uc_login" association="assoc_customer_login"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_search_product">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_search_product_source" type="actor_customer" association="assoc_customer_search_product"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_search_product_target" type="uc_search_product" association="assoc_customer_search_product"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_view_product">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_view_product_source" type="actor_customer" association="assoc_customer_view_product"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_view_product_target" type="uc_view_product" association="assoc_customer_view_product"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_add_to_cart">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_add_to_cart_source" type="actor_customer" association="assoc_customer_add_to_cart"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_add_to_cart_target" type="uc_add_to_cart" association="assoc_customer_add_to_cart"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_place_order">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_place_order_source" type="actor_customer" association="assoc_customer_place_order"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_place_order_target" type="uc_place_order" association="assoc_customer_place_order"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_view_ordered_products">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_view_ordered_products_source" type="actor_customer" association="assoc_customer_view_ordered_products"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_view_ordered_products_target" type="uc_view_ordered_products" association="assoc_customer_view_ordered_products"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="assoc_customer_manage_cart">
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_manage_cart_source" type="actor_customer" association="assoc_customer_manage_cart"/>
                <ownedEnd xmi:type="uml:Property" xmi:id="customer_manage_cart_target" type="uc_manage_cart" association="assoc_customer_manage_cart"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Extend" xmi:id="extend_search_by_text">
                <extendedCase xmi:idref="uc_search_by_text"/>
                <extension xmi:idref="uc_search_product"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Extend" xmi:id="extend_filter_search_results">
                <extendedCase xmi:idref="uc_filter_search_results"/>
                <extension xmi:idref="uc_search_product"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Include" xmi:id="include_voice_search">
                <addition xmi:idref="uc_record_voice_query"/>
                <includingCase xmi:idref="uc_search_by_voice"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Include" xmi:id="include_image_search">
                <addition xmi:idref="uc_upload_image"/>
                <includingCase xmi:idref="uc_search_by_image"/>
            </packagedElement>

        </packagedElement>
    </uml:Model>
</xmi:XMI>
