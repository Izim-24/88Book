<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
    xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
    xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

    <uml:Model xmi:id="model_ecommerce" name="E-commerce Class Diagram">
        <packagedElement xmi:type="uml:Package" xmi:id="pkg_domain" name="Domain Model">

            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_int" name="Integer"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_string" name="String"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_real" name="Real"/>
            <packagedElement xmi:type="uml:PrimitiveType" xmi:id="pt_date" name="Date"/>

            <packagedElement xmi:type="uml:Class" xmi:id="c_customer" name="Customer">
                <ownedAttribute xmi:id="c_customer_id" name="customerId" type="pt_int"/>
                <ownedAttribute xmi:id="c_customer_name" name="fullName" type="pt_string"/>
                <ownedAttribute xmi:id="c_customer_email" name="email" type="pt_string"/>
                <ownedAttribute xmi:id="c_customer_password" name="password" type="pt_string"/>
                <ownedAttribute xmi:id="c_customer_phone" name="phone" type="pt_string"/>
                <ownedAttribute xmi:id="c_customer_address" name="address" type="pt_string"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_category" name="Category">
                <ownedAttribute xmi:id="c_category_id" name="categoryId" type="pt_int"/>
                <ownedAttribute xmi:id="c_category_name" name="name" type="pt_string"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_product" name="Product">
                <ownedAttribute xmi:id="c_product_id" name="productId" type="pt_int"/>
                <ownedAttribute xmi:id="c_product_name" name="name" type="pt_string"/>
                <ownedAttribute xmi:id="c_product_desc" name="description" type="pt_string"/>
                <ownedAttribute xmi:id="c_product_price" name="price" type="pt_real"/>
                <ownedAttribute xmi:id="c_product_image" name="imageUrl" type="pt_string"/>
                <ownedAttribute xmi:id="c_product_stock" name="stock" type="pt_int"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_cart" name="Cart">
                <ownedAttribute xmi:id="c_cart_id" name="cartId" type="pt_int"/>
                <ownedAttribute xmi:id="c_cart_created" name="createdDate" type="pt_date"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_cartitem" name="CartItem">
                <ownedAttribute xmi:id="c_cartitem_id" name="cartItemId" type="pt_int"/>
                <ownedAttribute xmi:id="c_cartitem_qty" name="quantity" type="pt_int"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_order" name="Order">
                <ownedAttribute xmi:id="c_order_id" name="orderId" type="pt_int"/>
                <ownedAttribute xmi:id="c_order_date" name="orderDate" type="pt_date"/>
                <ownedAttribute xmi:id="c_order_total" name="totalAmount" type="pt_real"/>
                <ownedAttribute xmi:id="c_order_status" name="status" type="pt_string"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_orderitem" name="OrderItem">
                <ownedAttribute xmi:id="c_orderitem_id" name="orderItemId" type="pt_int"/>
                <ownedAttribute xmi:id="c_orderitem_qty" name="quantity" type="pt_int"/>
                <ownedAttribute xmi:id="c_orderitem_price" name="unitPrice" type="pt_real"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_searchhistory" name="SearchHistory">
                <ownedAttribute xmi:id="c_sh_id" name="searchId" type="pt_int"/>
                <ownedAttribute xmi:id="c_sh_type" name="searchType" type="pt_string"/>
                <ownedAttribute xmi:id="c_sh_text" name="queryText" type="pt_string"/>
                <ownedAttribute xmi:id="c_sh_image" name="imageUrl" type="pt_string"/>
                <ownedAttribute xmi:id="c_sh_created" name="createdAt" type="pt_date"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_voicesearch" name="VoiceSearchQuery">
                <ownedAttribute xmi:id="c_vs_id" name="voiceQueryId" type="pt_int"/>
                <ownedAttribute xmi:id="c_vs_audio" name="audioPath" type="pt_string"/>
                <ownedAttribute xmi:id="c_vs_text" name="recognizedText" type="pt_string"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Class" xmi:id="c_imagesearch" name="ImageSearchQuery">
                <ownedAttribute xmi:id="c_is_id" name="imageQueryId" type="pt_int"/>
                <ownedAttribute xmi:id="c_is_image" name="imagePath" type="pt_string"/>
                <ownedAttribute xmi:id="c_is_features" name="extractedFeatures" type="pt_string"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_customer_order" name="places">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_customer_order_e1" name="customer" type="c_customer" association="a_customer_order">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_customer_order_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_customer_order_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_customer_order_e2" name="orders" type="c_order" association="a_customer_order">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_customer_order_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_customer_order_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_customer_order_e1"/>
                <memberEnd xmi:idref="a_customer_order_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_customer_cart" name="owns">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_customer_cart_e1" name="customer" type="c_customer" association="a_customer_cart">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_customer_cart_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_customer_cart_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_customer_cart_e2" name="cart" type="c_cart" association="a_customer_cart">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_customer_cart_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_customer_cart_e2u" value="1"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_customer_cart_e1"/>
                <memberEnd xmi:idref="a_customer_cart_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_cart_cartitem" name="contains">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_cart_cartitem_e1" name="cart" type="c_cart" association="a_cart_cartitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_cart_cartitem_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_cart_cartitem_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_cart_cartitem_e2" name="items" type="c_cartitem" association="a_cart_cartitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_cart_cartitem_e2l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_cart_cartitem_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_cart_cartitem_e1"/>
                <memberEnd xmi:idref="a_cart_cartitem_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_product_cartitem" name="addedAs">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_product_cartitem_e1" name="product" type="c_product" association="a_product_cartitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_product_cartitem_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_product_cartitem_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_product_cartitem_e2" name="cartItems" type="c_cartitem" association="a_product_cartitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_product_cartitem_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_product_cartitem_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_product_cartitem_e1"/>
                <memberEnd xmi:idref="a_product_cartitem_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_order_orderitem" name="includes">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_order_orderitem_e1" name="order" type="c_order" association="a_order_orderitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_order_orderitem_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_order_orderitem_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_order_orderitem_e2" name="orderItems" type="c_orderitem" association="a_order_orderitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_order_orderitem_e2l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_order_orderitem_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_order_orderitem_e1"/>
                <memberEnd xmi:idref="a_order_orderitem_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_product_orderitem" name="orderedAs">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_product_orderitem_e1" name="product" type="c_product" association="a_product_orderitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_product_orderitem_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_product_orderitem_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_product_orderitem_e2" name="orderItems" type="c_orderitem" association="a_product_orderitem">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_product_orderitem_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_product_orderitem_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_product_orderitem_e1"/>
                <memberEnd xmi:idref="a_product_orderitem_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_category_product" name="categorizes">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_category_product_e1" name="category" type="c_category" association="a_category_product">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_category_product_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_category_product_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_category_product_e2" name="products" type="c_product" association="a_category_product">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_category_product_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_category_product_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_category_product_e1"/>
                <memberEnd xmi:idref="a_category_product_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_customer_search" name="performs">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_customer_search_e1" name="customer" type="c_customer" association="a_customer_search">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_customer_search_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_customer_search_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_customer_search_e2" name="searchHistories" type="c_searchhistory" association="a_customer_search">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_customer_search_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_customer_search_e2u" value="*"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_customer_search_e1"/>
                <memberEnd xmi:idref="a_customer_search_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_search_voice" name="voiceDetail">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_search_voice_e1" name="searchHistory" type="c_searchhistory" association="a_search_voice">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_search_voice_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_search_voice_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_search_voice_e2" name="voiceQuery" type="c_voicesearch" association="a_search_voice">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_search_voice_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_search_voice_e2u" value="1"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_search_voice_e1"/>
                <memberEnd xmi:idref="a_search_voice_e2"/>
            </packagedElement>

            <packagedElement xmi:type="uml:Association" xmi:id="a_search_image" name="imageDetail">
                <ownedEnd xmi:type="uml:Property" xmi:id="a_search_image_e1" name="searchHistory" type="c_searchhistory" association="a_search_image">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_search_image_e1l" value="1"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_search_image_e1u" value="1"/>
                </ownedEnd>
                <ownedEnd xmi:type="uml:Property" xmi:id="a_search_image_e2" name="imageQuery" type="c_imagesearch" association="a_search_image">
                    <lowerValue xmi:type="uml:LiteralInteger" xmi:id="a_search_image_e2l" value="0"/>
                    <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="a_search_image_e2u" value="1"/>
                </ownedEnd>
                <memberEnd xmi:idref="a_search_image_e1"/>
                <memberEnd xmi:idref="a_search_image_e2"/>
            </packagedElement>

        </packagedElement>
    </uml:Model>
</xmi:XMI>
