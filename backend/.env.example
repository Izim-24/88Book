PORT=5000
NODE_ENV=development

# Database - SQL Server
DB_AUTH=sql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=book_store
DB_USER=sa
DB_PASSWORD=replace_with_your_sql_server_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
OCR_LANGS=eng,vie

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# First admin account: set these only while running npm run bootstrap-admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=choose_a_unique_password_of_at_least_12_characters
# BOOTSTRAP_ADMIN_NAME=88Book Administrator

# CORS
FRONTEND_URL=http://localhost:5174

# Book guide: OpenAI-compatible chat completions endpoint
AI_API_URL=https://your-provider.example/v1/chat/completions
AI_MODEL=your-model-name
AI_API_KEY=your-secret-key
# Free option: Google Gemini (key from https://aistudio.google.com)
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_MODEL=gemini-3.1-flash-lite
# AI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# Optional reply budget (includes "thinking" tokens), default 2000
# AI_MAX_TOKENS=2000
