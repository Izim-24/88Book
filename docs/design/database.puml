  * id : bigint <<PK>>
  --
  name : text
}
entity "book_authors" as book_authors {
  * book_id : bigint <<PK, FK>>
  * author_id : bigint <<PK, FK>>
}
entity "categories" as categories {
  * id : bigint <<PK>>
  --
  name : text <<UQ>>
}
entity "book_categories" as book_categories {
  * book_id : bigint <<PK, FK>>
  * category_id : bigint <<PK, FK>>
}
entity "book_images" as book_images {
  * id : bigint <<PK>>
  --
  book_id : bigint <<FK>>
  object_key : text <<UQ>>
}
entity "inventory" as inventory {
  * book_id : bigint <<PK, FK>>
  --
  on_hand : integer
  reserved : integer
  version : bigint
}
entity "carts" as carts {
  * id : bigint <<PK>>
  --
  user_id : bigint <<FK, UQ>>
}
entity "cart_items" as cart_items {
  * id : bigint <<PK>>
  --
  cart_id : bigint <<FK>>
  book_id : bigint <<FK>>
  quantity : integer
}
entity "wishlists" as wishlists {
  * id : bigint <<PK>>
  --
  user_id : bigint <<FK, UQ>>
}
entity "wishlist_items" as wishlist_items {
  * wishlist_id : bigint <<PK, FK>>
  * book_id : bigint <<PK, FK>>
}
entity "coupons" as coupons {
  * id : bigint <<PK>>
  --
  code : text <<UQ>>
  validity and discount rules
}
entity "coupon_redemptions" as coupon_redemptions {
  * id : bigint <<PK>>
  --
  coupon_id : bigint <<FK>>
  user_id : bigint <<FK>>
  order_id : bigint <<FK, nullable>>
}
entity "orders" as orders {
  * id : bigint <<PK>>
  --
  user_id : bigint <<FK>>
  status : order_status
  address_snapshot : jsonb
  idempotency_key : text
}
entity "order_items" as order_items {
  * id : bigint <<PK>>
  --
  order_id : bigint <<FK>>
  book_id : bigint <<FK>>
  title_snapshot : text
  unit_price : numeric(12,2)
}
entity "inventory_reservations" as reservations {
  * id : bigint <<PK>>
  --
  order_id : bigint <<FK>>
  book_id : bigint <<FK>>
  quantity : integer
  expires_at : timestamptz
}
entity "payment_attempts" as payments {
  * id : bigint <<PK>>
  --
  order_id : bigint <<FK>>
  status : payment_status
  provider_reference : text
}
entity "shipments" as shipments {
  * id : bigint <<PK>>
  --
  order_id : bigint <<FK>>
  status : shipment_status
  tracking_number : text
}
entity "shipment_items" as shipment_items {
  * shipment_id : bigint <<PK, FK>>
  * order_item_id : bigint <<PK, FK>>
  quantity : integer
}
entity "shipment_events" as shipment_events {
  * id : bigint <<PK>>
  --
  shipment_id : bigint <<FK>>
  provider_event_id : text <<UQ>>
}
entity "reviews" as reviews {
  * id : bigint <<PK>>
  --
  user_id : bigint <<FK>>
  book_id : bigint <<FK>>
  rating : smallint
}
entity "notifications" as notifications {
  * id : bigint <<PK>>
  --
  user_id : bigint <<FK>>
  status / channel / payload
}
entity "image_embeddings" as embeddings {
  * book_image_id : bigint <<PK, FK>>
  * model_version : text <<PK>>
  embedding : vector
}
